<div class="page-head">
  <div>
    <h1>Attachments</h1>
    <p>Manage ingested source attachments across email, uploads, notes, and system records.</p>
    <% if @communication.present? %>
      <p>Filtered to communication: <%= @communication.display_title %></p>
    <% end %>
  </div>
  <%= link_to "New Attachment", new_attachment_path(communication_id: @communication&.id), class: "btn btn-primary" %>
</div>

<%= form_with url: attachments_path, method: :get, local: true, class: "toolbar" do %>
  <div style="flex: 1 1 320px;">
    <label for="q">Search</label>
    <%= text_field_tag :q, @query, placeholder: "Title, category, source, child" %>
  </div>
  <div style="display: flex; gap: 0.5rem; align-self: end;">
    <%= submit_tag "Filter", class: "btn" %>
    <%= link_to "Clear", attachments_path, class: "btn" %>
  </div>
<% end %>

<div class="table-wrap">
  <table class="table">
    <thead>
      <tr>
        <th>Title</th>
        <th>File</th>
        <th>Child</th>
        <th>Type</th>
        <th>Category</th>
        <th>AI</th>
        <th>Captured</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @attachments.each do |attachment| %>
        <tr>
          <td><%= link_to attachment.display_title, attachment_path(attachment) %></td>
          <td>
            <% if attachment.primary_file_type.present? %>
              <span class="file-icon <%= attachment.primary_file_type_css %>"><%= attachment.primary_file_type %></span>
            <% else %>
              -
            <% end %>
          </td>
          <td><%= attachment.child.name %></td>
          <td><%= attachment.source_type %> / <%= attachment.content_type %></td>
          <td><%= attachment.effective_category.presence || "-" %></td>
          <td><span class="badge badge-<%= attachment.ai_status %>"><%= attachment.ai_status %></span></td>
          <td><%= attachment.captured_at&.strftime("%Y-%m-%d %H:%M") || "-" %></td>
          <td>
            <div class="inline-actions">
              <%= link_to "Edit", edit_attachment_path(attachment), class: "btn" %>
              <%= button_to "Delete", attachment_path(attachment), method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: "Delete this attachment?" } } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
