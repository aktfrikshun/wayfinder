<div class="page-head">
  <div>
    <h1><%= @child.name %></h1>
    <p>Grade <%= @child.grade.presence || "-" %> · <%= @child.school_name.presence || "School not set" %></p>
  </div>
  <div class="inline-actions">
    <%= button_to "Regenerate Insights", regenerate_insights_parent_child_path(@child), method: :post, class: "btn btn-primary" %>
    <%= link_to "Chat", parent_child_chats_path(@child), class: "btn btn-primary" %>
    <%= link_to "Insights", insights_parent_child_path(@child), class: "btn btn-primary" %>
    <%= link_to "Edit", edit_parent_child_path(@child), class: "btn" %>
    <%= link_to "Back", parent_children_path, class: "btn" %>
  </div>
</div>

<div class="grid grid-2">
  <section class="card">
    <h3>Profile</h3>
    <p><strong>Name:</strong> <%= @child.name %></p>
    <p><strong>Nickname:</strong> <%= @child.nickname.presence || "-" %></p>
    <p><strong>Birthday:</strong> <%= @child.birthday&.strftime("%Y-%m-%d") || "-" %></p>
    <p><strong>Height:</strong> <%= @child.height.presence || "-" %></p>
    <p><strong>Weight:</strong> <%= @child.weight.presence || "-" %></p>
    <p><strong>Grade:</strong> <%= @child.grade.presence || "-" %></p>
    <p><strong>School:</strong> <%= @child.school_name.presence || "-" %></p>
    <p><strong>Child Code:</strong> <code><%= @child.inbound_alias.presence || "-" %></code></p>
    <p style="display: flex; align-items: center; gap: 0.5rem;">
      <span><strong>Forward-to Email:</strong> <code id="child-forward-email"><%= @child.inbound_alias.present? ? "#{@child.inbound_alias}-#{@child.id}@wf.frikshun.com" : "-" %></code></span>
      <% if @child.inbound_alias.present? %>
        <button type="button" class="btn" data-copy-target="#child-forward-email">Copy</button>
      <% end %>
    </p>
    <p class="muted" style="margin-top: 0.5rem;">Copy this address on school emails; the child ID suffix routes messages to the right profile.</p>
  </section>

  <section class="card">
    <h3>Communications</h3>
    <p><strong>Total:</strong> <%= @child.communications.count %></p>
    <div class="toolbar" style="margin-top: 0.6rem;">
      <%= link_to "View Messages", parent_communications_path(child_id: @child.id), class: "btn" %>
    </div>
  </section>
</div>

<section class="card" style="margin-top: 1rem;">
  <h3>Recent Messages</h3>
  <% if @recent_attachments.any? %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Subject</th>
            <th>Status</th>
            <th>Received</th>
          </tr>
        </thead>
        <tbody>
          <% @recent_attachments.each do |attachment| %>
            <tr>
              <td><%= link_to(attachment.display_title, parent_communication_path(attachment)) %></td>
              <td><span class="badge badge-<%= attachment.ai_status %>"><%= attachment.ai_status %></span></td>
              <td><%= attachment.occurred_at&.strftime("%Y-%m-%d %H:%M") || attachment.captured_at&.strftime("%Y-%m-%d %H:%M") || "-" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="muted">No communications for this child yet.</p>
  <% end %>
</section>
