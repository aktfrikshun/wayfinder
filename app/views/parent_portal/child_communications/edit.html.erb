<div class="page-head">
  <div>
    <h1>Edit Communication</h1>
    <p><%= @child.name %> · Manage communication details and associated attachments.</p>
  </div>
  <div class="inline-actions">
    <%= button_to "Reprocess AI", reprocess_parent_child_communication_path(@child, @communication), method: :post, class: "btn btn-primary" %>
  </div>
</div>

<section class="card" style="margin-bottom: 1rem;">
  <%= render "form" %>
</section>

<section class="card" style="margin-bottom: 1rem;">
  <div class="page-head" style="margin-bottom: 0.75rem;">
    <div>
      <h3>Add Attachment</h3>
      <p class="muted">Upload files to create attachments linked to this communication.</p>
    </div>
  </div>

  <%= form_with model: @new_attachment, url: attachments_parent_child_communication_path(@child, @communication), method: :post, local: true, multipart: true do |form| %>
    <div class="form-grid">
      <div>
        <%= form.label :title %>
        <%= form.text_field :title, placeholder: "Attachment title" %>
      </div>

      <div>
        <%= form.label :description, "Description / Context" %>
        <%= form.text_field :description, placeholder: "What is this file about?" %>
      </div>

      <div>
        <%= form.label :subject %>
        <%= form.text_field :subject, placeholder: @communication.subject %>
      </div>

      <div>
        <%= form.label :source_type %>
        <%= form.select :source_type, Attachment::SOURCE_TYPES, selected: "upload" %>
      </div>

      <div>
        <%= form.label :content_type %>
        <%= form.select :content_type, Attachment::CONTENT_TYPES, selected: "unknown" %>
      </div>

      <div class="full">
        <%= form.label :files, "Files" %>
        <%= form.file_field :files, multiple: true %>
      </div>

      <div class="full">
        <%= form.label :body_text, "Optional note" %>
        <%= form.text_area :body_text, placeholder: "Optional context for this attachment" %>
      </div>
    </div>

    <div class="toolbar" style="margin-top: 1rem;">
      <%= form.submit "Upload Attachment", class: "btn btn-primary" %>
    </div>
  <% end %>
</section>

<section class="card">
  <h3>Associated Attachments</h3>
  <% if @attachments.any? %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Title</th>
            <th>File</th>
            <th>Type</th>
            <th>Status</th>
            <th>Files</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @attachments.each do |attachment| %>
            <tr>
              <td><%= attachment.display_title %></td>
              <td>
                <% if attachment.primary_file_type.present? %>
                  <span class="file-icon <%= attachment.primary_file_type_css %>"><%= attachment.primary_file_type %></span>
                <% else %>
                  -
                <% end %>
              </td>
              <td><%= attachment.source_type %> / <%= attachment.content_type %></td>
              <td><span class="badge badge-<%= attachment.ai_status %>"><%= attachment.ai_status %></span></td>
              <td><%= attachment.files.count %></td>
              <td>
                <div class="inline-actions">
                  <%= link_to "View", parent_communication_path(attachment), class: "btn" %>
                  <%= button_to "Remove", attachment_parent_child_communication_path(@child, @communication, attachment_id: attachment.id), method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: "Remove this attachment?" } } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="muted">No attachments associated yet.</p>
  <% end %>
</section>
